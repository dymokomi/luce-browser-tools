# r51b+r52 paint recording oracle cases: "dl" (dump_display_list), "px X Y W H" (Skia pixels of a screenshot), "values".
values	
# boxes
dl	<!DOCTYPE html><div class=a></div><div class=b></div>	body { margin: 0; } div { width: 100px; height: 30px; margin: 5px 10px; } .a { background: #3a7; border: 5px solid #c33; } .b { background: rgb(20, 40, 200); border-width: 2px 4px 6px 8px; border-style: solid; border-color: red green blue orange; }
px 0 0 160 100	<!DOCTYPE html><div class=a></div><div class=b></div>	body { margin: 0; } div { width: 100px; height: 30px; margin: 5px 10px; } .a { background: #3a7; border: 5px solid #c33; } .b { background: rgb(20, 40, 200); border-width: 2px 4px 6px 8px; border-style: solid; border-color: red green blue orange; }
# border-styles
dl	<!DOCTYPE html><div class=dotted></div><div class=dashed></div><div class=double></div><div class=groove></div><div class=ridge></div><div class=inset></div><div class=outset></div>	body { margin: 0; display: block; } div { width: 120px; height: 10px; margin: 3px 4px; border: 6px solid rgb(40, 120, 200); } .dotted { border-style: dotted; } .dashed { border-style: dashed; border-color: rgb(200, 30, 30); } .double { border-style: double; border-width: 9px; } .groove { border-style: groove; } .ridge { border-style: ridge; } .inset { border-style: inset; } .outset { border-style: outset; border-color: rgb(10, 10, 10); }
px 0 0 150 190	<!DOCTYPE html><div class=dotted></div><div class=dashed></div><div class=double></div><div class=groove></div><div class=ridge></div><div class=inset></div><div class=outset></div>	body { margin: 0; display: block; } div { width: 120px; height: 10px; margin: 3px 4px; border: 6px solid rgb(40, 120, 200); } .dotted { border-style: dotted; } .dashed { border-style: dashed; border-color: rgb(200, 30, 30); } .double { border-style: double; border-width: 9px; } .groove { border-style: groove; } .ridge { border-style: ridge; } .inset { border-style: inset; } .outset { border-style: outset; border-color: rgb(10, 10, 10); }
# radii
dl	<!DOCTYPE html><div class=a></div><div class=b></div><div class=c></div><div class=d></div>	body { margin: 0; } div { display: inline-block; width: 60px; height: 50px; margin: 6px; vertical-align: top; } .a { background: #c33; border-radius: 12px; } .b { background: #3a7; border: 4px solid #234; border-radius: 20px 6px 30px 0; } .c { border: 8px solid rgb(250, 160, 0); border-radius: 50%; } .d { background: rgb(80, 80, 220); border: 3px dashed rgb(0, 0, 0); border-radius: 10px / 20px; }
px 0 0 320 80	<!DOCTYPE html><div class=a></div><div class=b></div><div class=c></div><div class=d></div>	body { margin: 0; } div { display: inline-block; width: 60px; height: 50px; margin: 6px; vertical-align: top; } .a { background: #c33; border-radius: 12px; } .b { background: #3a7; border: 4px solid #234; border-radius: 20px 6px 30px 0; } .c { border: 8px solid rgb(250, 160, 0); border-radius: 50%; } .d { background: rgb(80, 80, 220); border: 3px dashed rgb(0, 0, 0); border-radius: 10px / 20px; }
# shadows
dl	<!DOCTYPE html><div class=a></div><div class=b></div><div class=c></div><div class=d></div>	body { margin: 0; } div { display: inline-block; width: 60px; height: 50px; margin: 24px 12px; background: white; vertical-align: top; } .a { box-shadow: 4px 6px 0 rgb(0, 0, 0); } .b { box-shadow: 0 0 8px 2px rgba(200, 0, 0, 0.8); } .c { border-radius: 12px; box-shadow: 5px 5px 6px rgb(0, 80, 160), -3px -3px 0 3px rgb(0, 160, 80); } .d { background: rgb(240, 220, 100); box-shadow: inset 6px 4px 5px rgba(0, 0, 0, 0.6); border-radius: 8px; }
px 0 0 330 100	<!DOCTYPE html><div class=a></div><div class=b></div><div class=c></div><div class=d></div>	body { margin: 0; } div { display: inline-block; width: 60px; height: 50px; margin: 24px 12px; background: white; vertical-align: top; } .a { box-shadow: 4px 6px 0 rgb(0, 0, 0); } .b { box-shadow: 0 0 8px 2px rgba(200, 0, 0, 0.8); } .c { border-radius: 12px; box-shadow: 5px 5px 6px rgb(0, 80, 160), -3px -3px 0 3px rgb(0, 160, 80); } .d { background: rgb(240, 220, 100); box-shadow: inset 6px 4px 5px rgba(0, 0, 0, 0.6); border-radius: 8px; }
# gradients
dl	<!DOCTYPE html><div class=a></div><div class=b></div><div class=c></div><div class=d></div>	body { margin: 0; } div { display: inline-block; width: 70px; height: 70px; margin: 8px 4px; vertical-align: top; } .a { background: linear-gradient(to right, red, blue); } .b { background: linear-gradient(45deg, rgb(255, 200, 0) 20%, rgb(0, 120, 60) 80%); border-radius: 10px; } .c { background: radial-gradient(circle, white, rgb(0, 0, 160)); } .d { background: repeating-linear-gradient(90deg, black 0 5px, white 5px 10px); }
px 0 0 310 90	<!DOCTYPE html><div class=a></div><div class=b></div><div class=c></div><div class=d></div>	body { margin: 0; } div { display: inline-block; width: 70px; height: 70px; margin: 8px 4px; vertical-align: top; } .a { background: linear-gradient(to right, red, blue); } .b { background: linear-gradient(45deg, rgb(255, 200, 0) 20%, rgb(0, 120, 60) 80%); border-radius: 10px; } .c { background: radial-gradient(circle, white, rgb(0, 0, 160)); } .d { background: repeating-linear-gradient(90deg, black 0 5px, white 5px 10px); }
# outline-clip
dl	<!DOCTYPE html><div class=a></div><div class=b></div>	body { margin: 0; } div { width: 80px; height: 30px; margin: 20px; padding: 6px; border: 4px solid rgba(0, 0, 0, 0.5); } .a { background: rgb(100, 200, 100); background-clip: padding-box; outline: 3px solid rgb(200, 0, 200); outline-offset: 4px; } .b { background: rgb(100, 100, 220); background-clip: content-box; outline: 2px dashed rgb(0, 0, 0); }
px 0 0 140 150	<!DOCTYPE html><div class=a></div><div class=b></div>	body { margin: 0; } div { width: 80px; height: 30px; margin: 20px; padding: 6px; border: 4px solid rgba(0, 0, 0, 0.5); } .a { background: rgb(100, 200, 100); background-clip: padding-box; outline: 3px solid rgb(200, 0, 200); outline-offset: 4px; } .b { background: rgb(100, 100, 220); background-clip: content-box; outline: 2px dashed rgb(0, 0, 0); }
