# layers
dl	<!DOCTYPE html><div class=a></div><div class=b></div><div class=c></div>	body { margin: 0; } div { position: absolute; width: 80px; height: 80px; } .a { left: 10px; top: 10px; background: rgb(255, 0, 0); } .b { left: 50px; top: 30px; background: rgb(0, 0, 255); opacity: 0.5; z-index: 2; } .c { left: 30px; top: 50px; background: rgb(0, 160, 0); z-index: 1; }
