features	text-rendering: optimizeSpeed; font-variant-ligatures: common-ligatures	
features	font-variant-ligatures: no-common-ligatures discretionary-ligatures no-historical-ligatures contextual	
features	font-variant-ligatures: common-ligatures no-discretionary-ligatures historical-ligatures no-contextual	
features	font-variant-position: sub	
features	font-variant-position: super	
features	font-variant-caps: small-caps	
features	font-variant-caps: all-small-caps	
features	font-variant-caps: petite-caps	
features	font-variant-caps: all-petite-caps	
features	font-variant-caps: unicase	
features	font-variant-caps: titling-caps	
features	font-variant-numeric: oldstyle-nums proportional-nums diagonal-fractions ordinal slashed-zero	
features	font-variant-numeric: lining-nums tabular-nums stacked-fractions	
features	font-variant-east-asian: jis78 full-width ruby	
features	font-variant-east-asian: jis83 proportional-width	
features	font-variant-east-asian: jis90	
features	font-variant-east-asian: jis04	
features	font-variant-east-asian: simplified	
features	font-variant-east-asian: traditional	
features	font-kerning: normal	
features	font-kerning: none	
features	font-kerning: auto; text-rendering: optimizeSpeed	
features	font-feature-settings: "liga" 0, "smcp", "ss01" 3	
features	font-variant-caps: small-caps; font-feature-settings: "smcp" 0, "kern" 2	
features	font-variant-alternates: historical-forms	
features	font-variant-alternates: stylistic(foo) swash(bar) ornaments(baz) annotation(qux)	stylistic:foo=2;swash:bar=3;ornaments:baz=4;annotation:qux=5
features	font-variant-alternates: styleset(a, b)	styleset:a=1,20,100,0;styleset:b=99
features	font-variant-alternates: character-variant(c)	character-variant:c=5,7
features	font-variant-alternates: character-variant(c)	character-variant:c=12
features	font-variant-alternates: character-variant(c)	character-variant:c=100,3
features	font-variant-alternates: stylistic(missing)	stylistic:foo=2
features	font-variant-alternates: stylistic(foo); font-feature-settings: "salt" 9	stylistic:foo=300
