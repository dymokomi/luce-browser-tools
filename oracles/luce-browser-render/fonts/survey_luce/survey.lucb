import ak
import c
import memory
import web_fonts
import gfx
import strings

extern func fopen(path: c.str, mode: c.str) -> void*?
extern func fclose(stream: void*) -> i32
extern func fread(buffer: void*, size: usize, count: usize, stream: void*) -> usize

func read_file(path: c.str) -> ak.ByteBuffer?:
    let stream = fopen(path, "rb") else return none
    defer _ = fclose(stream)
    var buffer: ak.ByteBuffer
    var chunk: u8[65536]
    while true:
        let count = fread(&chunk[0], 1, chunk.length, stream)
        if count == 0:
            break
        ak.byte_buffer_try_append_span_u8(&buffer, chunk[0..<count]) else return none
    return buffer

struct Hex:
    var bytes: u8[8]

func hex8(value: u32) -> Hex:
    let digits = "0123456789abcdef".bytes
    var result: Hex
    for i in 0..<8:
        result.bytes[i] = digits[(usize)((value >> (u32)(28 - 4 * i)) & 0xF)]
    return result

func text_of(s: ak.FlyString) -> str:
    return ak.string_view_text(ak.fly_string_bytes_as_string_view(&s))

func survey(path: str, tf: web_fonts.Typeface*):
    print(f"{path}: family={text_of(web_fonts.typeface_family(tf))} w={web_fonts.typeface_weight(tf)} wd={web_fonts.typeface_width(tf)} s={web_fonts.typeface_slope(tf)} upem={web_fonts.typeface_units_per_em(tf)} glyphs={web_fonts.typeface_glyph_count(tf)}")
    let sizes: f32[2] = [9.75, 12.0]
    for pt in sizes:
        let font = web_fonts.typeface_font(tf, pt)
        let m = web_fonts.font_pixel_metrics(font)
        let a = hex8(m.x_height.bits())
        let b = hex8(m.advance_of_ascii_zero.bits())
        let c0 = hex8(m.ascent.bits())
        let d = hex8(m.descent.bits())
        let e = hex8(m.line_gap.bits())
        let f = hex8(web_fonts.font_preferred_line_height(font).bits())
        let label = "9.75" if pt == 9.75 else "12"
        print(f"  {label}: {(str)a.bytes[0..]} {(str)b.bytes[0..]} {(str)c0.bytes[0..]} {(str)d.bytes[0..]} {(str)e.bytes[0..]} {(str)f.bytes[0..]}")
    let cps: u32[14] = [0x20, 0x41, 0x61, 0x30, 0xE9, 0x416, 0x3B1, 0x5D0, 0x627, 0x4E00, 0x1F600, 0xFB01, 0x2014, 0xA0]
    var line: ak.StringBuilder
    ak.string_builder_construct(&line)
    ak.string_builder_append(&line, "  ids:")
    for cp in cps:
        var number: u8[16]
        let text = strings.format(number, f" {web_fonts.typeface_glyph_id_for_code_point(tf, cp)}") else ""
        ak.string_builder_append(&line, text)
    let ids = ak.string_builder_to_string(&line) else trap("?")
    print(ak.string_view_text(ak.string_bytes_as_string_view(&ids)))
    let font = web_fonts.typeface_font(tf, 12.0)
    let samples: str[3] = ["Hello, World! fi fl ffi AV To", "caf\u{E9} na\u{EF}ve e\u{301}", "\u{41F}\u{440}\u{438}\u{432}\u{435}\u{442} \u{3B1}\u{3B2}\u{3B3}"]
    for sample in samples:
        let text = ak.utf16_string_from_str(sample)
        let run = web_fonts.shape_text_f32(gfx.FloatPoint(m_x = 0.0, m_y = 0.0), 0.0, ak.utf16_string_base_utf16_view(&text.utf16_string_base), font, web_fonts.GlyphRunTextType.common)
        var out: ak.StringBuilder
        ak.string_builder_construct(&out)
        let w = hex8(web_fonts.glyph_run_width(run).bits())
        ak.string_builder_append(&out, "  shape ")
        ak.string_builder_append(&out, (str)w.bytes[0..])
        ak.string_builder_append(&out, ":")
        for g in ak.vector_span_const(&run.m_glyphs):
            var number: u8[16]
            let x = hex8(g.position.m_x.bits())
            let text2 = strings.format(number, f" {g.glyph_id}@") else ""
            ak.string_builder_append(&out, text2)
            ak.string_builder_append(&out, (str)x.bytes[0..])
        let line2 = ak.string_builder_to_string(&out) else trap("?")
        print(ak.string_view_text(ak.string_bytes_as_string_view(&line2)))
    let path_cps: u32[3] = [(u32)'a', (u32)'Q', (u32)'&']
    for cp in path_cps:
        let glyph_path = web_fonts.font_glyph_path(font, web_fonts.typeface_glyph_id_for_code_point(tf, cp), 1.0)
        var acc: u32 = 0
        var n: i32 = 0
        var point: usize = 0
        let points = ak.vector_span_const(&glyph_path.points)
        for verb in ak.vector_span_const(&glyph_path.verbs):
            let count: usize = match verb:
                .move => 1
                .line => 1
                .quad => 2
                .cubic => 3
                _ => 0
            for i in 0..<count:
                acc = acc *% 31 +% points[point + i].m_x.bits()
                acc = acc *% 31 +% points[point + i].m_y.bits()
            point += count
            let sk_verb: u32 = match verb:
                .move => 0
                .line => 1
                .quad => 2
                .cubic => 4
                _ => 5
            acc = acc *% 31 +% sk_verb
            n += 1
        let hh = hex8(acc)
        print(f"  path {cp}: {n} {(str)hh.bytes[0..]}")

pub func main(arguments: c.str[]) -> i32:
    for index in 1..<arguments.length:
        let path = str(arguments[index]) else continue
        let buffer = read_file(arguments[index]) else continue
        let typeface_or_error: web_fonts.Typeface*? = web_fonts.typeface_try_load_from_temporary_memory(ak.byte_buffer_bytes_const(&buffer)) catch:
            recover none
        if let tf = typeface_or_error:
            survey(path, tf)
        else:
            print(f"{path}: error")
    return 0
